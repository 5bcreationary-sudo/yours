# ───────── Frontend (Vite) — copy to .env.local ─────────
# Public, safe to ship. Anon key is rate-limited and gated by RLS.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key>
VITE_APP_BASE_URL=https://yours.fm

# ───────── Edge Function secrets ─────────
# Set via: supabase secrets set KEY=value  (do NOT put these in .env.local)

# Supabase (auto-set by `supabase secrets set` from project; listed for clarity)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service role key>
SUPABASE_ANON_KEY=<anon key>

# Anthropic — claude-sonnet-4-6 script generation
ANTHROPIC_API_KEY=sk-ant-...

# OpenWeatherMap — One Call 3.0 subscription required
OPENWEATHER_API_KEY=<32-char key>

# Google OAuth (for Gmail + Calendar). Redirect URI must include
# https://<project-ref>.supabase.co/auth/v1/callback
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...

# LLM provider: "anthropic" or "gemini" (default: anthropic)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# TTS provider: "google" (default) or "fish"
TTS_PROVIDER=google

# Google Cloud TTS — two-host podcast voices (with SSML support)
# Chirp3-HD voices are the most natural-sounding. Alternatives:
#   Studio: en-US-Studio-O / en-US-Studio-Q
#   Journey: en-US-Journey-D / en-US-Journey-F
# See: https://cloud.google.com/text-to-speech/docs/voices
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE_A=en-US-Chirp3-HD-Charon
GOOGLE_TTS_VOICE_B=en-US-Chirp3-HD-Achernar
GOOGLE_TTS_SPEAKING_RATE=1.0

# Intro music: set to "true" to prepend a jingle before the podcast.
# Requires intro-1.mp3 / intro-2.mp3 in briefing-audio storage bucket,
# encoded to match TTS output (24kHz mono MP3, no ID3 tags).
ENABLE_INTRO_MUSIC=false

# Fish Audio TTS — alternative provider. If unset, audio pipeline no-ops cleanly.
FISH_AUDIO_API_KEY=
FISH_AUDIO_VOICE_ID_A=
FISH_AUDIO_VOICE_ID_B=

# Twilio — optional in v1. If unset, send-sms returns stubbed:true.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Signed-link JWT secret — 32+ random bytes. Rotate invalidates existing links.
#   openssl rand -base64 48
BRIEFING_LINK_JWT_SECRET=<base64 random>

# AES-GCM key for encrypting Google OAuth refresh tokens in user_sources.
# Exactly 32 bytes, base64-encoded. Rotate → force-reconnect for all users.
#   openssl rand -base64 32
ENCRYPTION_KEY=<base64 32 bytes>

# Absolute URL the SMS link points to (used by issue-briefing-link).
APP_BASE_URL=https://yours.fm

# ───────── One-time DB GUCs (set via psql, not secrets) ─────────
# alter database postgres set app.edge_base_url   = 'https://<project-ref>.supabase.co';
# alter database postgres set app.service_role_key = '<service role key>';
